# Окружение сборки проекта «Секретарь» (решение Р-17 — сборка в контейнере).
FROM node:22-alpine

# Кэш npm в /tmp: контейнер работает от пользователя хоста, домашний каталог ему недоступен.
ENV npm_config_cache=/tmp/.npm

WORKDIR /app

# Исходники монтируются томом из docker-compose.yml, копирование в образ не нужно.
CMD ["npm", "run", "dev"]
