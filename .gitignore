# Секреты и локальные настройки
.env
.env.*
!.env.example
.claude/settings.local.json
# Ключ подписи APK (пароли к нему — в .env.android, его покрывает .env.*)
release.keystore

# Собранный APK
secretar.apk

# Зависимости и сборка
node_modules/
dist/
build/
coverage/

# Среда разработки
.idea/
.vscode/
*.swp
.DS_Store

# Временные файлы запуска
.run/
*.log

# Кэш сборки Vite
.vite/
node_modules/.vite/
node_modules/.vite-temp/
*.tsbuildinfo

# Артефакты vite-plugin-pwa (генерируются в dist/)
dev-dist/

# Файлы моделей для голоса (2,6 ГБ, раздаются с компьютера — docs/mechanic_voice.md).
# Сам каталог в git — через .gitkeep: иначе docker создал бы его от root, и model-download не смог бы писать.
models/*
!models/.gitkeep
memory/tmp_*/
